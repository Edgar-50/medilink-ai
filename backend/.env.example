DATABASE_URL=sqlite:///./medilink.db
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
FRONTEND_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_PATH=./storage
BACKGROUND_JOBS_ENABLED=true
FHIR_BASE_URL=/api/v1/fhir
MQTT_BROKER=localhost
MQTT_PORT=1883
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
DEFAULT_FACILITY_NAME=MediLink Central Hospital
DEFAULT_FACILITY_CODE=ML-CENTRAL

# MediLink Copilot LLM
# auto: OpenAI when OPENAI_API_KEY is set, otherwise local record-grounded fallback.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Keep false for real patient data unless your deployment has the required data-processing agreements.
LLM_ALLOW_RECORD_CONTEXT=false
LLM_TIMEOUT_SECONDS=30
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
